<Bindings>
	<Binding name="TOUCHCONTROLS_INTERACT" header="TOUCHCONTROLS">
		TouchControls_Interact()
	</Binding>
	<Binding name="TOUCHCONTROLS_TARGETNONHOSTILE">
		TouchControls_TargetNonHostile()
	</Binding>
	<Binding name="TOUCHCONTROLS_TOGGLE">
		TouchControls_Toggle()
	</Binding>
	<Binding name="TOUCHCONTROLS_MENU">
		TouchControls_ToggleMenu()
	</Binding>
	<Binding name="TOUCHCONTROLS_NEXTGROUP">
		TouchControls_NextGroup()
	</Binding>
	<Binding name="TOUCHCONTROLS_BAGS">
		OpenAllBags()
	</Binding>
	<Binding name="TOUCHCONTROLS_RADIAL">
		TouchControls_ToggleRadial()
	</Binding>
	<Binding name="TOUCHCONTROLS_ASSIGN">
		TouchControls_AssignStart()
	</Binding>
	<Binding name="TOUCHCONTROLS_DISMOUNT">
		if ( CanExitVehicle() ) then
			VehicleExit();
		else
			Dismount();
		end
	</Binding>
	<Binding name="TOUCHCONTROLS_MODIFIER">
		TouchControls_CycleModifier()
	</Binding>
	<Binding name="TOUCHCONTROLS_CHAT">
		TouchControls_ToggleChat()
	</Binding>
	<Binding name="TOUCHCONTROLS_FOLLOW">
		FollowUnit("target")
	</Binding>
</Bindings>
